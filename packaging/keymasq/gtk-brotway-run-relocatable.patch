+/* Resolve the private runtime next to this executable.  AppImage packaging can
+ * override the result explicitly with BROTWAY_PREFIX. */
+static char *resolve_prefix(void)
+{
+  const char *configured = getenv("BROTWAY_PREFIX");
+  if (configured && *configured)
+    return strdup(configured);
+
+  char executable[PATH_MAX];
+  ssize_t length = readlink("/proc/self/exe", executable, sizeof executable - 1);
+  if (length > 0 && (size_t) length < sizeof executable)
+    {
+      executable[length] = '\0';
+      return strdup(dirname(executable));
+    }
+
+  return strdup(DEFAULT_PREFIX);
+}
+
+static void prepend_path(const char *name, const char *directory)
+{
+  const char *current = getenv(name);
+  char *value;
+  if (current && *current)
+    {
+      if (asprintf(&value, "%s:%s", directory, current) < 0)
+        exit(1);
+    }
+  else
+    value = strdup(directory);
+  if (!value || setenv(name, value, 1) != 0)
+    exit(1);
+  free(value);
+}
